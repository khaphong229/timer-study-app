<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardElevation="0dp"
    app:cardCornerRadius="0dp"
    android:backgroundTint="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="@null">        <!-- Filter and task count -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Spinner
                android:id="@+id/spinnerFilterPriority"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/spinner_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/cbShowCompleted"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@null"
                app:buttonCompat="@drawable/custom_checkbox_selector"
                android:layout_marginStart="8dp"/>

            <TextView
                android:id="@+id/tvTaskCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textColor="#6C5CE7"
                android:textStyle="bold"
                android:text="0/0"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:background="@drawable/count_badge_bg"
                android:paddingVertical="4dp"/>
        </LinearLayout>

        <!-- Progress Bar with new design -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <ProgressBar
                android:id="@+id/progressBarDaily"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="10dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/progress_gradient"
                android:backgroundTint="#FFFFFF"
                />

            <TextView
                android:id="@+id/tvProgressPercentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textSize="14sp"
                android:textColor="#6C5CE7"
                android:textStyle="bold"
                android:paddingStart="12dp"
                android:minWidth="45dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>