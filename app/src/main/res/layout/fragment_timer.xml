<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".view.fragments.TimerFragment">

    <!-- GIF Background - Layer dưới cùng -->
    <pl.droidsonroids.gif.GifImageView
            android:id="@+id/gifImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:adjustViewBounds="false"
            android:src="@drawable/bg_default"
            android:clickable="true"
            android:focusable="true" />

    <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#4D000000" />

    <!-- Floating Action Button ở góc trái -->
    <ImageButton
            android:id="@+id/btn_timer_settings"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="start|top"
            android:layout_margin="16dp"
            android:src="@drawable/ic_timer_set_time"
            android:background="@drawable/fab_background"
            android:scaleType="centerInside"
            android:contentDescription="Timer Settings"
            android:padding="12dp"
            android:elevation="4dp" />

    <!-- SeekBar Panel - Ẩn/hiện khi nhấn icon -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_seekbar_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="#CC000000"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_study_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Study: 25 min"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekbar_study"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tv_break_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Break: 5 min"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekbar_break"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Content layer - Đè lên GIF background -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

        <!-- Main Timer Card - Chứa tất cả -->
        <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="16dp"
                android:background="#CC7A7A"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="20dp">

            <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                <!-- Background với blur effect -->
                <View
                        android:id="@+id/timer_blur_background"
                        android:layout_width="251dp"
                        android:layout_height="324dp"
                        android:background="#AE404040" />

                <!-- Content container -->
                <LinearLayout
                        android:layout_width="252dp"
                        android:layout_height="323dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="32dp">

                    <!-- Session Type với dấu đỏ -->
                    <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="24dp"
                            android:background="@drawable/session_chip_inline"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="6dp">

                        <!-- Dấu đỏ -->
                        <View
                                android:id="@+id/session_indicator"
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/red_dot" />

                        <TextView
                                android:id="@+id/tv_session_type"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.05"
                                android:text="Study Session"
                                android:textAllCaps="true"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColorHighlight="@android:color/transparent"
                                android:textColorHint="#FFFFFF"
                                android:textColorLink="#FFFFFF" />

                    </LinearLayout>

                    <!-- Hidden ImageView -->
                    <ImageView
                        android:id="@+id/img_time_bg"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:contentDescription="@string/app_name"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <!-- Timer -->
                    <TextView
                            android:id="@+id/tv_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="20dp"
                            android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false"
                            android:shadowColor="#0F0F0F"
                            android:shadowDx="8"
                            android:shadowDy="8"
                            android:shadowRadius="2"
                            android:text="25:00"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="54sp"
                            android:textStyle="bold" />

                    <!-- Completed Sessions -->
                    <TextView
                            android:id="@+id/tv_completed_sessions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="32dp"
                            android:fontFamily="sans-serif-condensed-medium"
                            android:text="0 sessions"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />

                    <!-- Control Buttons -->
                    <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="61dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btn_play_pause"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_marginEnd="16dp"
                            android:background="@drawable/button_circle_primary"
                            android:contentDescription="Play/Pause"
                            android:padding="16dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_play_48"
                            app:tint="#FFFFFF" />

                        <ImageButton
                            android:id="@+id/btn_reset"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:background="@drawable/button_circle_secondary"
                            android:contentDescription="Reset"
                            android:padding="16dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_reset_48"
                            app:tint="#666666" />

                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</FrameLayout>
